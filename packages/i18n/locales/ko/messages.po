#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/backend</0> — networkless JWT verify, request auth, "
"webhooks."
msgstr "<0>@xid-kit/backend</0> — 네트워크 호출 없는 JWT 검증, 요청 인증, webhook."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/core</0> — browser session, tokens, Management API helpers."
msgstr "<0>@xid-kit/core</0> — 브라우저 세션, token, 관리 API 헬퍼."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/nextjs</0> — middleware and App/Pages Router server helpers."
msgstr "<0>@xid-kit/nextjs</0> — middleware 및 App/Pages Router 서버 헬퍼."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/react-native</0> — Hosted Auth redirect, PKCE S256, secure "
"token storage for native apps."
msgstr "<0>@xid-kit/react-native</0> — Hosted Auth 리디렉션, PKCE S256, 네이티브 앱용 안전한 "
"토큰 저장소."

#: apps/server/src/routes/docs/index.tsx
#~ msgid "<0>@xid-kit/react-native</0> — native redirect + PKCE scaffold."
#~ msgstr "<0>@xid-kit/react-native</0> — 네이티브 리디렉션 + PKCE 스캐폴드."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/react</0> — provider, hooks, control and UI components."
msgstr "<0>@xid-kit/react</0> — provider, hook, 제어 컴포넌트 및 UI 컴포넌트."

#: apps/server/src/routes/docs/sdk-docs/native-server-dotnet.tsx
msgid "<0>AddXid()</0> registers <1>XidClient</1> as a singleton and wires "
"<2>IHttpClientFactory</2> for JWKS fetching."
msgstr "<0>AddXid()</0>는 <1>XidClient</1>를 싱글턴으로 등록하고 JWKS 가져오기를 위해 "
"<2>IHttpClientFactory</2>를 연결합니다."

#: apps/server/src/routes/docs/sdk-docs/native-server-go.tsx
msgid "<0>Claims</0> embeds <1>jwt.RegisteredClaims</1> and adds "
"<2>ClientID</2>, <3>Scope</3>, <4>AMR</4>, <5>ACR</5>, <6>OrgID</6>, "
"<7>OrgSlug</7>."
msgstr "<0>Claims</0>는 <1>jwt.RegisteredClaims</1>를 임베드하며 <2>ClientID</2>, "
"<3>Scope</3>, <4>AMR</4>, <5>ACR</5>, <6>OrgID</6>, <7>OrgSlug</7>를 "
"추가합니다."

#: apps/server/src/routes/docs/sdk-docs/nuxt.tsx
msgid "<0>createXidServerMiddleware</0> returns an H3 event handler that "
"verifies the JWT networklessly and writes <1>event.context.xidAuth</1>. "
"Place the file in <2>server/middleware/</2> so Nitro registers it as a "
"global middleware."
msgstr "<0>createXidServerMiddleware</0>는 JWT를 네트워크 호출 없이 검증하고 "
"<1>event.context.xidAuth</1>에 결과를 기록하는 H3 이벤트 핸들러를 반환합니다. Nitro가 전역 "
"미들웨어로 등록할 수 있도록 파일을 <2>server/middleware/</2>에 배치하세요."

#: apps/server/src/routes/docs/sdk-docs/nuxt.tsx
msgid "<0>event.context.xidAuth</0> is server-side only and is never sent to "
"the browser."
msgstr "<0>event.context.xidAuth</0>는 서버 전용이며 브라우저로 전송되지 않습니다."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>false</0> deprovisions the user and revokes active sessions."
msgstr "<0>false</0>는 사용자를 프로비저닝 해제하고 활성 세션을 폐기합니다."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>GET /auth/config</0> returns the public Hosted Auth configuration for "
"the organization. Provider secrets and disabled providers are not "
"returned to the browser."
msgstr "<0>GET /auth/config</0>는 조직의 공개 Hosted Auth 설정을 반환합니다. 공급자 비밀값과 비활성 "
"공급자는 브라우저에 반환되지 않습니다."

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>getAuth</0> extracts a bearer token or session cookie, verifies it "
"networklessly, and returns an <1>AuthResult</1>. <2>requireAuth</2> "
"automatically throws a 302 redirect to <3>redirectPath</3> when "
"unauthenticated."
msgstr "<0>getAuth</0>는 bearer 토큰 또는 세션 cookie를 추출하여 네트워크 호출 없이 검증한 후 "
"<1>AuthResult</1>를 반환합니다. <2>requireAuth</2>는 미인증 시 자동으로 "
"<3>redirectPath</3>로 302 리디렉션을 발생시킵니다."

#: apps/server/src/routes/docs/sdk-docs/solid.tsx
msgid "<0>getToken()</0> returns a short-lived JWT (60 s) cached by "
"<1>TokenManager</1> in <2>@xid-kit/core</2>."
msgstr "<0>getToken()</0>은 <2>@xid-kit/core</2>의 <1>TokenManager</1>가 캐시하는 단기 "
"JWT(60초)를 반환합니다."

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>getToken()</0> returns a short-lived JWT for API calls. Verify "
"networklessly on your backend with JWKS."
msgstr "<0>getToken()</0>은 API 호출용 단기 JWT를 반환합니다. 백엔드에서 JWKS를 이용해 네트워크 호출 없이 "
"검증하세요."

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>handleCallback</0> validates the <1>state</1> parameter against the "
"session to prevent CSRF."
msgstr "<0>handleCallback</0>은 CSRF를 방지하기 위해 세션에 대한 <1>state</1> 파라미터를 검증합니다."

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>handleCallback</0> validates the <1>state</1> parameter to prevent "
"CSRF, exchanges the authorization code, and returns a <2>Response</2> "
"with <3>Set-Cookie</3>."
msgstr "<0>handleCallback</0>은 CSRF를 방지하기 위해 <1>state</1> 파라미터를 검증하고, 인증 코드를 "
"교환한 후 <3>Set-Cookie</3>가 포함된 <2>Response</2>를 반환합니다."

#: apps/server/src/routes/docs/sdk-docs/astro.tsx
msgid "<0>jwtKey</0> is a JWKS public key; it is safe for networkless "
"verification and does not contain a private key."
msgstr "<0>jwtKey</0>는 JWKS 공개 키이므로 네트워크 호출 없는 검증에 안전하게 사용할 수 있으며 개인 키를 포함하지 "
"않습니다."

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>load()</0> reads <1>/v1/me</1> and hydrates user, session, and active "
"organization."
msgstr "<0>load()</0>은 <1>/v1/me</1>를 읽어 사용자, 세션, 활성 조직을 초기화합니다."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>POST /scim/v2/organizations/{organization_id}/Bulk</0> accepts a "
"<1>BulkRequest</1> with up to 100 operations and a 1 MiB payload limit. "
"Responses return per-operation HTTP status in a <2>BulkResponse</2> even "
"when some operations fail."
msgstr "<0>POST /scim/v2/organizations/{organization_id}/Bulk</0>는 최대 100개 작업, "
"1MiB 페이로드 제한의 <1>BulkRequest</1>를 받습니다. 일부 작업이 실패해도 "
"<2>BulkResponse</2>에서 작업별 HTTP 상태를 반환합니다."

#: apps/server/src/routes/docs/sdk-docs/astro.tsx
msgid "<0>secretKey</0> (<1>sk_live_xxx</1>) must stay server-side only; never "
"pass it to an island or client bundle."
msgstr "<0>secretKey</0>(<1>sk_live_xxx</1>)는 반드시 서버 측에서만 사용해야 합니다. island나 "
"클라이언트 번들에 전달하지 마세요."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>ServiceProviderConfig</0> advertises <1>sort.supported=true</1>, "
"<2>bulk.supported=true</2>, and <3>etag.supported=true</3>."
msgstr "<0>ServiceProviderConfig</0>는 <1>sort.supported=true</1>, "
"<2>bulk.supported=true</2>, <3>etag.supported=true</3>를 공개합니다."

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>setActiveOrganization()</0> switches org context and clears the token "
"cache before reloading state."
msgstr "<0>setActiveOrganization()</0>은 조직 컨텍스트를 전환하고 상태를 다시 로드하기 전에 token 캐시를 "
"초기화합니다."

#: apps/server/src/routes/docs/sdk-docs/react-native.tsx
msgid "<0>signIn()</0> builds the PKCE S256 authorize URL, stores the verifier "
"and OAuth state in the token cache, opens the browser adapter, and "
"exchanges the returned code for tokens. Browser failure, CSRF state "
"mismatch, and token exchange errors surface as <1>signInState.status === "
"'error'</1>."
msgstr "<0>signIn()</0>은 PKCE S256 인증 URL을 생성하고, 검증자와 OAuth state를 토큰 캐시에 저장한 후 "
"브라우저 어댑터를 열어 반환된 코드를 토큰으로 교환합니다. 브라우저 오류, CSRF state 불일치, 토큰 교환 오류는 "
"<1>signInState.status === 'error'</1>로 나타납니다."

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>signInPassword()</0> establishes a cookie session through Hosted Auth "
"password flow."
msgstr "<0>signInPassword()</0>는 Hosted Auth 비밀번호 흐름을 통해 cookie 세션을 생성합니다."

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>signOut()</0> revokes the browser session cookie."
msgstr "<0>signOut()</0>은 브라우저 세션 cookie를 폐기합니다."

#: apps/server/src/routes/docs/index.tsx
msgid "<0>urn:xid:aal3</0> is issued only when passkey MFA meets hardware "
"single-device, non-backed-up assurance. Syncable passkeys do not qualify "
"for AAL3."
msgstr "<0>urn:xid:aal3</0>는 패스키 MFA가 하드웨어 단일 기기, 비백업 보증을 충족할 때만 발급됩니다. 동기화 가능한 "
"패스키는 AAL3에 해당하지 않습니다."

#: apps/server/src/routes/docs/sdk-docs/expo.tsx
msgid "<0>useAuth().isSignedIn</0> reflects the <1>XidClient</1> web-cookie "
"session state, which does not auto-populate from the local SecureStore "
"tokens after token exchange. Reload client state explicitly after a "
"successful sign-in."
msgstr "<0>useAuth().isSignedIn</0>은 <1>XidClient</1> 웹 cookie 세션 상태를 반영하며, 토큰 "
"교환 후 로컬 SecureStore 토큰에서 자동으로 채워지지 않습니다. 로그인 성공 후 클라이언트 상태를 명시적으로 다시 "
"로드하세요."

#: apps/server/src/routes/docs/sdk-docs/native-server-ruby.tsx
msgid "<0>Xid.authenticate_request</0> accepts both a Rack env hash and a Rack "
"<1>Request</1> object."
msgstr "<0>Xid.authenticate_request</0>는 Rack env 해시와 Rack <1>Request</1> 객체를 "
"모두 허용합니다."

#: apps/server/src/routes/docs/sdk-docs/native-server-rust.tsx
msgid "<0>XidError</0> uses <1>thiserror</1> for structured error variants "
"including <2>JwtValidation</2>, <3>JwksFetch</3>, <4>KeyNotFound</4>, "
"<5>IssuerMismatch</5>, and webhook-specific variants."
msgstr "<0>XidError</0>는 <1>thiserror</1>를 사용하며 <2>JwtValidation</2>, "
"<3>JwksFetch</3>, <4>KeyNotFound</4>, <5>IssuerMismatch</5> 및 webhook "
"전용 변형을 포함한 구조적 오류 변형을 제공합니다."

#: apps/server/src/routes/docs/sdk-docs/nextjs.tsx
msgid "<0>xidMiddleware()</0> runs on the Edge Runtime, verifies the session "
"JWT networklessly, and injects auth state into downstream request "
"headers for server components and route handlers."

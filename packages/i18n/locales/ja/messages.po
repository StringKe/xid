#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/backend</0> — networkless JWT verify, request auth, webhooks."
msgstr "<0>@xid-kit/backend</0> — ネットワーク不要の JWT 検証、リクエスト認証、webhook。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/core</0> — browser session, tokens, Management API helpers."
msgstr "<0>@xid-kit/core</0> — ブラウザーセッション、トークン、Management API ヘルパー。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/nextjs</0> — middleware and App/Pages Router server helpers."
msgstr "<0>@xid-kit/nextjs</0> — middleware および App/Pages Router サーバーヘルパー。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/react-native</0> — Hosted Auth redirect, PKCE S256, secure token storage for native apps."
msgstr "<0>@xid-kit/react-native</0> — Hosted Auth リダイレクト、PKCE S256、ネイティブアプリ向けセキュアトークンストレージ。"

#: apps/server/src/routes/docs/index.tsx
#~ msgid "<0>@xid-kit/react-native</0> — native redirect + PKCE scaffold."
#~ msgstr "<0>@xid-kit/react-native</0> — ネイティブリダイレクト + PKCE scaffold。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>@xid-kit/react</0> — provider, hooks, control and UI components."
msgstr "<0>@xid-kit/react</0> — provider、hooks、コントロールコンポーネントおよび UI コンポーネント。"

#: apps/server/src/routes/docs/sdk-docs/native-server-dotnet.tsx
msgid "<0>AddXid()</0> registers <1>XidClient</1> as a singleton and wires <2>IHttpClientFactory</2> for JWKS fetching."
msgstr "<0>AddXid()</0> は <1>XidClient</1> をシングルトンとして登録し、JWKS 取得用に <2>IHttpClientFactory</2> を組み込みます。"

#: apps/server/src/routes/docs/sdk-docs/native-server-go.tsx
msgid "<0>Claims</0> embeds <1>jwt.RegisteredClaims</1> and adds <2>ClientID</2>, <3>Scope</3>, <4>AMR</4>, <5>ACR</5>, <6>OrgID</6>, <7>OrgSlug</7>."
msgstr "<0>Claims</0> は <1>jwt.RegisteredClaims</1> を埋め込み、<2>ClientID</2>、<3>Scope</3>、<4>AMR</4>、<5>ACR</5>、<6>OrgID</6>、<7>OrgSlug</7> を追加します。"

#: apps/server/src/routes/docs/sdk-docs/nuxt.tsx
msgid "<0>createXidServerMiddleware</0> returns an H3 event handler that verifies the JWT networklessly and writes <1>event.context.xidAuth</1>. Place the file in <2>server/middleware/</2> so Nitro registers it as a global middleware."
msgstr "<0>createXidServerMiddleware</0> は JWT をネットワークレスで検証し <1>event.context.xidAuth</1> に書き込む H3 イベントハンドラーを返します。Nitro がグローバルミドルウェアとして登録するよう <2>server/middleware/</2> に配置してください。"

#: apps/server/src/routes/docs/sdk-docs/nuxt.tsx
msgid "<0>event.context.xidAuth</0> is server-side only and is never sent to the browser."
msgstr "<0>event.context.xidAuth</0> はサーバーサイド専用で、ブラウザには送信されません。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>false</0> deprovisions the user and revokes active sessions."
msgstr "<0>false</0> はユーザーのプロビジョニングを解除し、アクティブなセッションを取り消します。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>GET /auth/config</0> returns the public Hosted Auth configuration for the organization. Provider secrets and disabled providers are not returned to the browser."
msgstr "<0>GET /auth/config</0> は組織の公開 Hosted Auth 設定を返します。プロバイダーのシークレットと無効なプロバイダーはブラウザーに返されません。"

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>getAuth</0> extracts a bearer token or session cookie, verifies it networklessly, and returns an <1>AuthResult</1>. <2>requireAuth</2> automatically throws a 302 redirect to <3>redirectPath</3> when unauthenticated."
msgstr "<0>getAuth</0> はベアラートークンまたはセッション Cookie を取得してネットワークレスで検証し、<1>AuthResult</1> を返します。<2>requireAuth</2> は未認証時に <3>redirectPath</3> への 302 リダイレクトを自動的にスローします。"

#: apps/server/src/routes/docs/sdk-docs/solid.tsx
msgid "<0>getToken()</0> returns a short-lived JWT (60 s) cached by <1>TokenManager</1> in <2>@xid-kit/core</2>."
msgstr "<0>getToken()</0> は <2>@xid-kit/core</2> の <1>TokenManager</1> によってキャッシュされる短期 JWT（60 秒）を返します。"

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>getToken()</0> returns a short-lived JWT for API calls. Verify networklessly on your backend with JWKS."
msgstr "<0>getToken()</0> は API 呼び出し用の短期 JWT を返します。バックエンドで JWKS を使ってネットワーク不要で検証してください。"

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>handleCallback</0> validates the <1>state</1> parameter against the session to prevent CSRF."
msgstr "<0>handleCallback</0> は CSRF を防ぐためにセッションに対して <1>state</1> パラメーターを検証します。"

#: apps/server/src/routes/docs/sdk-docs/remix.tsx
msgid "<0>handleCallback</0> validates the <1>state</1> parameter to prevent CSRF, exchanges the authorization code, and returns a <2>Response</2> with <3>Set-Cookie</3>."
msgstr "<0>handleCallback</0> は CSRF を防ぐために <1>state</1> パラメーターを検証し、認可コードを交換して <3>Set-Cookie</3> を含む <2>Response</2> を返します。"

#: apps/server/src/routes/docs/sdk-docs/astro.tsx
msgid "<0>jwtKey</0> is a JWKS public key; it is safe for networkless verification and does not contain a private key."
msgstr "<0>jwtKey</0> は JWKS 公開鍵です。ネットワークレス検証に安全で、秘密鍵を含みません。"

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>load()</0> reads <1>/v1/me</1> and hydrates user, session, and active organization."
msgstr "<0>load()</0> は <1>/v1/me</1> を読み取り、ユーザー、セッション、アクティブな組織を初期化します。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>POST /scim/v2/organizations/{organization_id}/Bulk</0> accepts a <1>BulkRequest</1> with up to 100 operations and a 1 MiB payload limit. Responses return per-operation HTTP status in a <2>BulkResponse</2> even when some operations fail."
msgstr "<0>POST /scim/v2/organizations/{organization_id}/Bulk</0> は最大 100 操作、1 MiB ペイロード上限の <1>BulkRequest</1> を受け付けます。一部が失敗しても <2>BulkResponse</2> で操作ごとの HTTP ステータスを返します。"

#: apps/server/src/routes/docs/sdk-docs/astro.tsx
msgid "<0>secretKey</0> (<1>sk_live_xxx</1>) must stay server-side only; never pass it to an island or client bundle."
msgstr "<0>secretKey</0>（<1>sk_live_xxx</1>）はサーバーサイド専用にしてください。アイランドやクライアントバンドルには渡さないでください。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>ServiceProviderConfig</0> advertises <1>sort.supported=true</1>, <2>bulk.supported=true</2>, and <3>etag.supported=true</3>."
msgstr "<0>ServiceProviderConfig</0> は <1>sort.supported=true</1>、<2>bulk.supported=true</2>、<3>etag.supported=true</3> を公開します。"

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>setActiveOrganization()</0> switches org context and clears the token cache before reloading state."
msgstr "<0>setActiveOrganization()</0> は組織コンテキストを切り替え、状態を再読み込みする前にトークンキャッシュをクリアします。"

#: apps/server/src/routes/docs/sdk-docs/react-native.tsx
msgid "<0>signIn()</0> builds the PKCE S256 authorize URL, stores the verifier and OAuth state in the token cache, opens the browser adapter, and exchanges the returned code for tokens. Browser failure, CSRF state mismatch, and token exchange errors surface as <1>signInState.status === 'error'</1>."
msgstr "<0>signIn()</0> は PKCE S256 認可 URL を構築し、ベリファイアーと OAuth state をトークンキャッシュに保存し、ブラウザアダプターを開き、返されたコードをトークンと交換します。ブラウザ失敗、CSRF state 不一致、トークン交換エラーは <1>signInState.status === 'error'</1> として表面化します。"

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>signInPassword()</0> establishes a cookie session through Hosted Auth password flow."
msgstr "<0>signInPassword()</0> は Hosted Auth のパスワードフローを通じて cookie セッションを確立します。"

#: apps/server/src/routes/docs/sdk-docs/core.tsx
msgid "<0>signOut()</0> revokes the browser session cookie."
msgstr "<0>signOut()</0> はブラウザーのセッション cookie を取り消します。"

#: apps/server/src/routes/docs/index.tsx
msgid "<0>urn:xid:aal3</0> is issued only when passkey MFA meets hardware single-device, non-backed-up assurance. Syncable passkeys do not qualify for AAL3."
msgstr "<0>urn:xid:aal3</0> は、パスキー MFA がハードウェア単一デバイスかつ非バックアップ保証を満たす場合にのみ発行されます。同期可能なパスキーは AAL3 の対象になりません。"

#: apps/server/src/routes/docs/sdk-docs/expo.tsx
msgid "<0>useAuth().isSignedIn</0> reflects the <1>XidClient</1> web-cookie session state, which does not auto-populate from the local SecureStore tokens after token exchange. Reload client state explicitly after a successful sign-in."
msgstr "<0>useAuth().isSignedIn</0> は <1>XidClient</1> の Web Cookie セッション状態を反映します。トークン交換後にローカルの SecureStore トークンから自動取得されません。サインイン成功後はクライアント状態を明示的にリロードしてください。"

#: apps/server/src/routes/docs/sdk-docs/native-server-ruby.tsx
msgid "<0>Xid.authenticate_request</0> accepts both a Rack env hash and a Rack <1>Request</1> object."
msgstr "<0>Xid.authenticate_request</0> は Rack env ハッシュと Rack <1>Request</1> オブジェクトの両方を受け入れます。"

#: apps/server/src/routes/docs/sdk-docs/native-server-rust.tsx
msgid "<0>XidError</0> uses <1>thiserror</1> for structured error variants including <2>JwtValidation</2>, <3>JwksFetch</3>, <4>KeyNotFound</4>, <5>IssuerMismatch</5>, and webhook-specific variants."
msgstr "<0>XidError</0> は <1>thiserror</1> を使って <2>JwtValidation</2>、<3>JwksFetch</3>、<4>KeyNotFound</4>、<5>IssuerMismatch</5>、webhook 固有のバリアントを含む構造化エラーバリアントを定義します。"

#: apps/server/src/routes/docs/sdk-docs/nextjs.tsx
msgid "<0>xidMiddleware()</0> runs on the Edge Runtime, verifies the session JWT networklessly, and injects auth state into downstream request headers for server components and route handlers."
msgstr "<0>xidMiddleware()</0> は Edge Runtime で動作し、セッション JWT をネットワーク不要で検証し、サーバーコンポーネントとルートハンドラー向けに認証状態を下流のリクエストヘッダーに注入します。"


#: apps/server/src/lib/page-seo-messages.ts
msgid "XID is an edge-native identity platform for OIDC, OAuth, organization RBAC, enterprise SSO, SCIM, passkeys, and networkless JWT verification on Cloudflare."
msgstr "XID ist eine edge-native Identitätsplattform für OIDC, OAuth, Organisations-RBAC, Enterprise-SSO, SCIM, Passkeys und netzwerklose JWT-Verifizierung auf Cloudflare.Organisations-RBAC, Enterprise-SSO, SCIM, Passkeys und netzwerklose JWT-Verifizierung auf Cloudflare.Organisations-RBAC, Enterprise-SSO, SCIM, Passkeys und netzwerklose JWT-Verifizierung auf Cloudflare."

#: apps/server/src/routes/docs/index.tsx
msgid "XID is an identity provider. The instance domain is the OIDC issuer, API base URL, Hosted Auth base URL, and console base URL. Organizations provide policy, branding, membership, and resource isolation."
msgstr "XID ist ein Identitätsanbieter. Die Instanzdomain ist OIDC-Aussteller, API-Basis-URL, Hosted Auth-Basis-URL und Konsolen-Basis-URL. Organisationen liefern Richtlinie, Branding, Mitgliedschaft und Ressourcenisolierung."

#: apps/server/src/routes/home/HeroSection.tsx
#~ msgid "XID is an OIDC / OAuth identity provider with explicit support levels, organization RBAC, provider-ready enterprise SAML/OIDC federation, inbound SCIM, local downstream SaaS SAML and SCIM baselines, and Web, Backend, React, and Next.js SDKs. It runs on Cloudflare's global network, while real provider and SaaS production support remains tied to L4 evidence instead of local mock runs."
#~ msgstr "DE: XID is an OIDC / OAuth identity provider with explicit support levels, organization RBAC, provider-ready enterprise SAML/OIDC federation, inbound SCIM, local downstream SaaS SAML and SCIM baselines, and Web, Backend, React, and Next.js SDKs. It runs on Cloudflare's global network, while real provider and SaaS production support remains tied to L4 evidence instead of local mock runs."


{
  "name": "@xid-kit/electron",
  "version": "0.0.0",
  "private": true,
  "description": "Electron SDK for XID: main-process PKCE flow, preload bridge and renderer auth client.",
  "homepage": "https://xid.dev",
  "bugs": {
    "url": "https://github.com/StringKe/xid/issues"
  },
  "license": "MIT",
  "author": "StringKe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StringKe/xid.git",
    "directory": "packages/electron"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main/index.ts",
      "import": "./src/main/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "import": "./src/renderer/index.ts"
    },
    "./preload": {
      "types": "./src/preload/index.ts",
      "import": "./src/preload/index.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.json",
    "test": "vp test"
  },
  "dependencies": {
    "@xid-kit/core": "workspace:*",
    "@xid-kit/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^43.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=28"
  }
}

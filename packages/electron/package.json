{
  "name": "@xid-kit/electron",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Electron main, preload, and renderer SDK for the XID identity platform.",
  "keywords": [
    "authentication",
    "identity",
    "oidc",
    "xid"
  ],
  "homepage": "https://xid.dev/sdks/electron",
  "bugs": {
    "url": "https://github.com/StringKe/xid/issues"
  },
  "license": "MIT",
  "author": "StringKe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StringKe/xid.git",
    "directory": "packages/electron"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main/index.d.mts",
      "import": "./dist/main/index.mjs",
      "default": "./dist/main/index.mjs"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.mts",
      "import": "./dist/renderer/index.mjs",
      "default": "./dist/renderer/index.mjs"
    },
    "./preload": {
      "types": "./dist/preload/index.d.mts",
      "import": "./dist/preload/index.mjs",
      "default": "./dist/preload/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/main/index.ts src/renderer/index.ts src/preload/index.ts --copy ../../LICENSE",
    "check": "vp check",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.json",
    "test": "vp test"
  },
  "dependencies": {
    "@xid-kit/core": "workspace:^",
    "@xid-kit/crypto": "workspace:^",
    "@xid-kit/types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^42.7.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=28"
  }
}

{
  "name": "@xid-kit/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte SDK for XID: auth stores, context and server-side session helpers.",
  "homepage": "https://xid.dev",
  "bugs": {
    "url": "https://github.com/StringKe/xid/issues"
  },
  "license": "MIT",
  "author": "StringKe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StringKe/xid.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {

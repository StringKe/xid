    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0",
    "@xid-kit/backend": "workspace:*",
    "svelte": ">=5.0.0"
  },

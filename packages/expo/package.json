{
  "name": "@xid-kit/expo",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Expo adapters and React Native bindings for the XID identity platform.",
  "keywords": [
    "authentication",
    "identity",
    "oidc",
    "xid"
  ],
  "homepage": "https://xid.dev/sdks/expo",
  "bugs": {
    "url": "https://github.com/StringKe/xid/issues"
  },
  "license": "MIT",
  "author": "StringKe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StringKe/xid.git",
    "directory": "packages/expo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --copy ../../LICENSE",
    "check": "vp check",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.json",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@xid-kit/react-native": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expo": "^56.0.17",
    "expo-secure-store": "^56.0.4",
    "expo-web-browser": "^56.0.6",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "^0.86.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "expo": ">=51",
    "expo-secure-store": ">=13",
    "expo-web-browser": ">=14",
    "react": "^19",
    "react-native": ">=0.73"
  }
}

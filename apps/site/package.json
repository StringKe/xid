{
  "name": "@xid-kit/site",
  "version": "0.0.0",
  "private": true,
  "description": "XID localized developer documentation powered by Cloudflare Nimbus.",
  "homepage": "https://xid.dev",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-localized-404s.mjs && node scripts/audit-dist-routes.mjs",
    "audit:dist": "node scripts/audit-dist-routes.mjs",
    "check": "astro check && nimbus-docs lint && pnpm run lint:prose",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "generate:content": "node scripts/generate-localized-content.mjs",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:prose": "pnpm run generate:content && textlint 'src/content/generated/docs/{*.mdx,sdks/**/*.mdx}'",
    "bundle:cf": "pnpm run build && wrangler versions upload --dry-run",
    "prepreview:cf": "pnpm run build",
    "preview:cf": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@cloudflare/nimbus-docs": "catalog:",
    "@lingui/core": "catalog:",
    "@xid-kit/i18n": "workspace:*",
    "@xid-kit/types": "workspace:*",
    "astro": "catalog:",
    "astro-icon": "^1.1.0",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "textlint": "^14.0.0",
    "textlint-plugin-mdx": "^1.0.1",
    "textlint-rule-alex": "^5.0.0",
    "textlint-rule-terminology": "^5.2.0",
    "textlint-rule-write-good": "^2.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}

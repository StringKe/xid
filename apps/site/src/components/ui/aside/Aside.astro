---
// Nimbus :::note 等指令渲染到这里；外观同产品 Notice：浅色调底、16px 图标、6px 圆角、无彩色侧边线。
import type { IconName } from "@xid-kit/web-ui/icon-glyphs";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import Icon from "../icon/Icon.astro";

interface Props extends HTMLAttributes<"aside"> {
  type?: "note" | "tip" | "caution" | "danger";
  title?: string;
}

const { type = "note", title, class: className, ...attrs } = Astro.props;

const tones: Record<NonNullable<Props["type"]>, { icon: IconName; surface: string; mark: string }> = {
  note: { icon: "info-circle", surface: "bg-info-bg", mark: "text-info" },
  tip: { icon: "check-circle", surface: "bg-success-bg", mark: "text-success" },
  caution: { icon: "alert-triangle", surface: "bg-warning-bg", mark: "text-warning" },
  danger: { icon: "alert-circle", surface: "bg-danger-bg", mark: "text-danger" },
};
const tone = tones[type];
---

<aside
  role="note"
  aria-label={title}
  class={cn("notice my-6 flex gap-3 rounded-md px-3.5 py-3 text-base", tone.surface, className)}
  {...attrs}
>
  <Icon name={tone.icon} class={cn("mt-0.5", tone.mark)} />
  <div class="flex min-w-0 flex-1 flex-col gap-0.5">
    {title && <p class="m-0 font-medium text-foreground">{title}</p>}
    <div class={cn("notice-body", title ? "text-muted-foreground" : "text-foreground")}>
      <slot />
    </div>
  </div>
</aside>

<style>
  .notice-body :global(p) {
    margin: 0;
  }
  .notice-body :global(p + p) {
    margin-top: 0.375rem;
  }
</style>

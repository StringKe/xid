---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import {
  buttonVariants,
  type ButtonShape,
  type ButtonSize,
  type ButtonVariant,
} from "../button/variants";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  shape?: ButtonShape;
}

const { href, variant, size, shape, class: className, ...attrs } = Astro.props;
---

<a href={href} class={cn(buttonVariants({ variant, size, shape }), className)} {...attrs}>
  <slot />
</a>

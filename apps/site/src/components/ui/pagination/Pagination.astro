---
import { cn } from "@/lib/cn";
import type { PrevNext } from "@cloudflare/nimbus-docs/types";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

interface Props {
  prevNext: PrevNext;
  class?: string;
}

const { prevNext, class: className } = Astro.props;
const { prev, next } = prevNext;
const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
const link = "group flex flex-col gap-0.5 rounded-sm no-underline";
const title = "text-base font-medium leading-[1.125rem] text-foreground transition-colors duration-[120ms] ease-out group-hover:text-accent";
---

{(prev || next) && (
  <nav
    aria-label={translate(siteShellMessages.pagination)}
    class={cn("mt-12 flex items-start justify-between gap-6 border-t border-border pt-5", className)}
  >
    {prev ? (
      <a href={prev.href} class={link}>
        <span class="text-xs text-faint-foreground">{translate(siteShellMessages.previous)}</span>
        <span class={title}>{prev.label}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={next.href} class={cn(link, "items-end text-right")}>
        <span class="text-xs text-faint-foreground">{translate(siteShellMessages.next)}</span>
        <span class={title}>{next.label}</span>
      </a>
    ) : <span />}
  </nav>
)}

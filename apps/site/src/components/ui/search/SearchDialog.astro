---
import { Dialog, DialogClose, DialogContent } from "@/components/ui/dialog";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";
import Icon from "../icon/Icon.astro";

const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
const searchDocs = translate(siteShellMessages.searchDocs);
const typeToSearch = translate(siteShellMessages.typeToSearch);
---

<Dialog
  aria-label={searchDocs}
  data-search-dialog
  data-label-type-to-search={typeToSearch}
  data-label-build-only={translate(siteShellMessages.searchBuildOnly)}
  data-label-searching={translate(siteShellMessages.searching)}
  data-label-no-results={translate(siteShellMessages.noSearchResults)}
  data-label-unavailable={translate(siteShellMessages.searchUnavailable)}
>
  <DialogContent>
    <div class="flex h-12 items-center gap-3 border-b border-border px-4 text-faint-foreground">
      <Icon name="search" />
      <input
        data-search-input
        role="combobox"
        name="docs-search"
        aria-label={searchDocs}
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-autocomplete="list"
        aria-controls="search-listbox"
        type="text"
        placeholder={searchDocs}
        class="min-w-0 flex-1 border-0 bg-transparent text-md text-foreground placeholder:text-faint-foreground focus:outline-none"
        autocomplete="off"
        spellcheck="false"
        autocorrect="off"
        autocapitalize="none"
      />
      <DialogClose class="xid-kbd cursor-pointer border-0">Esc</DialogClose>
    </div>

    <div
      data-search-results
      role="listbox"
      id="search-listbox"
      aria-orientation="vertical"
      class="min-h-40 overflow-y-auto p-2"
    >
      <p data-search-empty class="py-8 text-center text-base text-muted-foreground">
        {typeToSearch}
      </p>
    </div>

    <div class="flex items-center gap-4 border-t border-border px-4 py-2.5 text-xs text-faint-foreground">
      <span>{translate(siteShellMessages.navigateResults)}</span>
      <span>{translate(siteShellMessages.selectResult)}</span>
      <span>{translate(siteShellMessages.closeSearch)}</span>
    </div>
  </DialogContent>
</Dialog>

<script>
  import "./search.client";
</script>

---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import { getSiteLocale } from "@/lib/site-locale";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
}

const { markdownUrl, lastUpdated, class: className, ...attrs } = Astro.props;
const locale = getSiteLocale(Astro.url.pathname);
const updated = translateSiteMessage(Astro.url.pathname, siteShellMessages.updated);
const copyPage = translateSiteMessage(Astro.url.pathname, siteShellMessages.copyPage);
const copied = translateSiteMessage(Astro.url.pathname, siteShellMessages.copied);
const copyFailed = translateSiteMessage(Astro.url.pathname, siteShellMessages.copyFailed);
const viewAsMarkdown = translateSiteMessage(
  Astro.url.pathname,
  siteShellMessages.viewAsMarkdown,
);

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-transparent px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2";

const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat(locale, { year: "numeric", month: "short", day: "numeric" }).format(lastUpdated)
  : null;
---

{(markdownUrl || lastUpdated) && (
  <div
    data-nb-page-actions
    data-md-url={markdownUrl}
    data-label-copy={copyPage}
    data-label-copied={copied}
    data-label-copy-failed={copyFailed}
    class={cn("not-prose -ml-2 flex flex-wrap items-center gap-y-1 text-[0.8125rem]", className)}
    {...attrs}
  >
    {lastUpdated && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:clock" class="w-3.5 h-3.5" />
        {updated} <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </span>
    )}

    {markdownUrl && lastUpdated && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="w-3.5 h-3.5" data-nb-page-actions-copy-icon is:inline />
          <Icon name="ph:check" class="hidden w-3.5 h-3.5 text-success" data-nb-page-actions-check-icon is:inline />
          <span data-nb-page-actions-label aria-live="polite">{copyPage}</span>
        </button>

        <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>

        <a
          href={markdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="w-3.5 h-3.5" />
          {viewAsMarkdown}
        </a>
      </>
    )}
  </div>
)}

<script>
  import "./page-actions.client";
</script>

---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...attrs } = Astro.props;
---

<div
  class={cn(
    // 超宽横向滚动；隐藏滚动条以免压住下划线指示器，仍可用滚轮/触摸/键盘。
    "relative flex overflow-x-auto overscroll-x-contain border-b border-border",
    "[scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
    className,
  )}
  role="tablist"
  data-nb-tabs-list
  {...attrs}
>
  <span
    class="pointer-events-none absolute bottom-0 h-0.5 rounded-t-sm bg-primary transition-[left,width] duration-200 ease-out"
    data-nb-tabs-indicator
    aria-hidden="true"
  ></span>
  <slot />
</div>

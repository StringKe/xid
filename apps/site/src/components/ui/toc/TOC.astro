---
import { cn } from "@/lib/cn";
import type { TOCItem } from "@cloudflare/nimbus-docs/types";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

interface Props {
  headings: TOCItem[];
  editUrl?: string;
  class?: string;
}

const { headings, editUrl, class: className } = Astro.props;
const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
const minDepth = Math.min(...headings.map((heading) => heading.depth));
const action = "text-sm text-muted-foreground no-underline transition-colors duration-[120ms] ease-out hover:text-foreground";
---

<div data-nb-toc class={cn("flex flex-col gap-2.5", className)}>
  {headings.length > 0 && (
    <>
      <p class="m-0 text-xs font-medium text-muted-foreground">{translate(siteShellMessages.onThisPage)}</p>
      <nav aria-label={translate(siteShellMessages.tableOfContents)}>
        <ul class="m-0 flex list-none flex-col border-l border-border p-0">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-nb-toc-link
                data-nb-slug={heading.slug}
                class="-ml-px block border-l border-transparent py-1 text-sm leading-5 text-muted-foreground no-underline transition-colors duration-[120ms] ease-out hover:text-foreground aria-[current=true]:border-foreground aria-[current=true]:text-foreground"
                style={`padding-left: ${0.75 + (heading.depth - minDepth) * 0.75}rem;`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </>
  )}
  <div class="flex flex-col gap-2 pt-4">
    {editUrl && (
      <a href={editUrl} target="_blank" rel="noopener" class={action}>{translate(siteShellMessages.editOnGitHub)}</a>
    )}
    <a href="#main-content" class={action}>{translate(siteShellMessages.backToTop)}</a>
  </div>
</div>

<script>
  import "./toc.client";
</script>

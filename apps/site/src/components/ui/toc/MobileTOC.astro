---
// 窄屏补全宽屏右栏目录：原生 select，控件规格同产品输入框（触屏 44px、16px 字）。
import { cn } from "@/lib/cn";
import type { TOCItem } from "@cloudflare/nimbus-docs/types";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";
import Icon from "../icon/Icon.astro";

interface Props {
  headings: TOCItem[];
  class?: string;
}

const { headings, class: className } = Astro.props;
const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
const minDepth = Math.min(...headings.map((heading) => heading.depth));
---

{headings.length > 0 && (
  <nav data-nb-mobile-toc aria-label={translate(siteShellMessages.onThisPage)} class={cn("relative", className)}>
    <select
      data-nb-mobile-toc-select
      name="toc-section"
      aria-label={translate(siteShellMessages.jumpToSection)}
      class="h-11 w-full cursor-pointer appearance-none rounded-md bg-card pl-3 pr-10 text-md text-foreground shadow-[inset_0_0_0_1px_var(--xid-border-strong)] focus-visible:shadow-[inset_0_0_0_1px_var(--xid-accent),0_0_0_3px_var(--xid-accent-wash)] focus-visible:outline-none"
    >
      <option value="_top">{translate(siteShellMessages.onThisPage)}</option>
      {headings.map((heading) => (
        <option value={heading.slug}>{`${"  ".repeat(Math.max(0, heading.depth - minDepth))}${heading.text}`}</option>
      ))}
    </select>
    <Icon name="caret-down" class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
  </nav>
)}

<script>
  import "./mobile-toc.client";
</script>

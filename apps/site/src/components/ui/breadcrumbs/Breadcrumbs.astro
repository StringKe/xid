---
import { cn } from "@/lib/cn";
import type { Breadcrumb } from "@cloudflare/nimbus-docs/types";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";
import Icon from "../icon/Icon.astro";

interface Props {
  items: Breadcrumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
const label = translateSiteMessage(Astro.url.pathname, siteShellMessages.breadcrumb);
---

{items.length > 1 && (
  <nav aria-label={label} class={cn("text-sm", className)}>
    <ol class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0 text-muted-foreground">
      {items.map((crumb, index) => (
        <li class="flex min-w-0 items-center gap-1.5">
          {index > 0 && <Icon name="chevron-right" size={14} class="text-faint-foreground" />}
          {crumb.href && index < items.length - 1 ? (
            <a href={crumb.href} class="truncate text-muted-foreground no-underline transition-colors duration-[120ms] ease-out hover:text-foreground">
              {crumb.label}
            </a>
          ) : (
            <span aria-current={index === items.length - 1 ? "page" : undefined} class="truncate text-foreground">{crumb.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

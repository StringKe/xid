---
import { cn } from "@/lib/cn";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";
import { buttonVariants } from "../button/variants";
import Icon from "../icon/Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const label = translateSiteMessage(Astro.url.pathname, siteShellMessages.toggleDarkMode);
---

<button
  type="button"
  data-theme-control
  data-scheme="light"
  class={cn(buttonVariants({ variant: "ghost", shape: "square" }), "group text-muted-foreground hover:text-foreground", className)}
  aria-label={label}
>
  <Icon name="moon" class="group-data-[scheme=dark]:hidden" />
  <Icon name="sun" class="hidden group-data-[scheme=dark]:inline-flex" />
</button>

<script>
  import "./theme-toggle.client";
</script>

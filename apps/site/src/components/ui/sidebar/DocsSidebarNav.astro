---
// 规格同 Console 侧栏：项 32px（粗指针 44px）、4px 圆角，当前项表面色加 1px 环、500 字重。
import { cn } from "@/lib/cn";
import type { DocsNavigation, DocsNavLink } from "@/lib/docs-navigation";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

interface Props {
  navigation: DocsNavigation;
  class?: string;
}

const { navigation, class: className } = Astro.props;
const overview = translateSiteMessage(Astro.url.pathname, siteShellMessages.overview);
const item =
  "flex min-h-8 items-center justify-between gap-2 rounded-sm px-2 text-base no-underline transition-colors duration-[120ms] ease-out focus-visible:outline-offset-[-2px] pointer-coarse:min-h-11";
const itemState = (isCurrent: boolean) =>
  isCurrent
    ? "bg-card font-medium text-foreground shadow-[0_0_0_1px_var(--xid-border)]"
    : "text-muted-foreground hover:text-foreground";
const isOpen = (link: DocsNavLink) => link.isCurrent || link.children.some((child) => child.isCurrent);
---

<nav aria-label={translateSiteMessage(Astro.url.pathname, siteShellMessages.sections)} class={cn("flex flex-col gap-5", className)}>
  <a
    href={navigation.hub.href}
    aria-current={navigation.hub.isCurrent ? "page" : undefined}
    class={cn(item, itemState(navigation.hub.isCurrent))}
  >
    {overview}
  </a>
  {navigation.groups.map((group) => (
    <div class="flex flex-col gap-0.5">
      <p class="flex h-6 items-center px-2 text-xs font-medium text-faint-foreground">{group.label}</p>
      <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
        {group.links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.isCurrent ? "page" : undefined}
              class={cn(item, itemState(link.isCurrent))}
            >
              <span>{link.label}</span>
              {link.children.length > 0 && (
                <span class={cn("text-xs tabular-nums", link.isCurrent ? "text-muted-foreground" : "text-faint-foreground")}>
                  {link.children.length}
                </span>
              )}
            </a>
            {link.children.length > 0 && isOpen(link) && (
              <ul class="m-0 ml-3 mt-0.5 flex list-none flex-col gap-0.5 border-l border-border p-0 pl-2">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={child.isCurrent ? "page" : undefined}
                      class={cn(item, itemState(child.isCurrent))}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

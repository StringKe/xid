---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"dialog"> {}

const { class: className, ...attrs } = Astro.props;
---

<dialog
  data-dialog
  class={cn("fixed inset-0 z-50 m-0 h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-scrim", className)}
  {...attrs}
>
  <slot />
</dialog>

<script>
  import "./dialog.client";
</script>

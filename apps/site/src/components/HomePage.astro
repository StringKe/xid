---
import "../styles/site-sections.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import ProductFrame from "./site/ProductFrame.astro";
import SectionHeader from "./site/SectionHeader.astro";
import { LinkButton } from "./ui/link-button";
import { getHomeSurface } from "../lib/home-surface";
import { hostedAuthHref, localizeSitePath, type SiteLocale } from "../lib/site-locale";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const surface = getHomeSurface(locale);
const { text } = surface;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "XID",
      url: new URL(surface.path, Astro.site ?? "https://xid.dev").href,
      description: surface.description,
      inLanguage: surface.locale,
    },
    {
      "@type": "SoftwareApplication",
      name: "XID",
      applicationCategory: "SecurityApplication",
      operatingSystem: "Cloudflare Workers",
      license: "https://opensource.org/license/mit",
      url: "https://github.com/StringKe/xid",
      description: surface.description,
    },
  ],
});
const head = [
  {
    tag: "script" as const,
    attrs: { type: "application/ld+json" },
    content: structuredData,
  },
];
const startFreeHref = hostedAuthHref("sign-up", locale);
const docs = (slug: string) => localizeSitePath(`/${slug}`, locale);
const selfHostingHref = docs("self-hosting");
const pricingHref = localizeSitePath("/pricing", locale);
const serverExample = [
  "import { authenticateRequest } from '@xid-kit/backend'",
  "",
  "const state = await authenticateRequest(request, {",
  "  jwtKey: env.XID_JWKS_PUBLIC_KEY,",
  "  issuer: 'https://xid.dev',",
  "})",
  "if (!state.isSignedIn) return new Response('Unauthorized', { status: 401 })",
].join("\n");
// 解码后的 access token 示例：typ=at+jwt，必带 tenant_id（oidc-oauth 规则）。
const accessTokenClaims = [
  ["typ", "at+jwt"],
  ["alg", "ES256"],
  ["iss", "https://xid.dev"],
  ["aud", "app_01JD3FLEETPLNR"],
  ["azp", "app_01JD3FLEETPLNR"],
  ["scope", "openid profile email organization"],
  ["exp", "1791397800"],
] as const;
const tenantClaim = { value: "org_01J8NWLOGISTX", organization: "Northwind Logistics" };
---

<BaseLayout
  title={surface.title}
  description={surface.description}
  markdownUrl={surface.markdownPath}
  socialImage="/og.png"
  head={head}
>
  <div class="min-h-screen">
    <SiteHeader />
    <main id="main-content" data-pagefind-body>
      <section class="home-hero" aria-labelledby="home-title" data-home-section="hero">
        <div class="site-section-inner home-hero-inner">
          <div class="home-hero-copy">
            <h1 id="home-title" class="home-hero-title">
              <span class="home-hero-question">{text.heroQuestion}</span>
              <span>{text.heroAnswer}</span>
            </h1>
            <p class="home-hero-lead">{text.heroLead}</p>
            <div class="home-hero-actions">
              <div class="home-actions">
                <LinkButton href={startFreeHref} size="lg">{text.startFreeOnCloud}</LinkButton>
                <LinkButton href={selfHostingHref} variant="secondary" size="lg">{text.selfHost}</LinkButton>
              </div>
              <p class="home-hero-note">{text.heroNote}</p>
            </div>
          </div>
          <div class="home-hero-visual">
            <ProductFrame
              frame="consoleUsers"
              viewport={1440}
              locale={locale}
              host="northwind.xid.dev/console/users"
              height={398}
              class="home-hero-console"
            />
            <ProductFrame
              frame="hostedSignIn"
              viewport={350}
              narrowViewport={356}
              locale={locale}
              elevated
              class="home-hero-signin"
            />
          </div>
        </div>
      </section>

      <section class="site-section" aria-labelledby="home-sign-in" data-home-section="sign-in">
        <div class="site-section-inner home-section-body">
          <SectionHeader
            id="home-sign-in"
            question={text.signInQuestion}
            answer={text.signInAnswer}
            lead={text.signInLead}
            link={{ href: docs("hosted-auth"), label: text.signInLink }}
          />
          <div class="home-figure">
            <ProductFrame
              frame="accountDevices"
              viewport={1150}
              narrowViewport={356}
              locale={locale}
              host="northwind.xid.dev/account/devices"
              height={498}
              narrowHeight={479}
            />
            <p class="site-evidence">{text.signInEvidence}</p>
          </div>
        </div>
      </section>

      <section class="site-section home-oidc" aria-labelledby="home-oidc" data-home-section="oidc">
        <div class="site-section-inner home-section-body">
          <SectionHeader
            id="home-oidc"
            question={text.oidcQuestion}
            answer={text.oidcAnswer}
            lead={text.oidcLead}
            link={{ href: docs("getting-started"), label: text.oidcLink }}
          />
          <div class="home-figure">
            <div class="code-with-result">
              <figure class="home-code">
                <figcaption>
                  <span>server.ts</span>
                  <span>ts</span>
                </figcaption>
                <pre><code>{serverExample}</code></pre>
              </figure>
              <div class="token-claims">
                <div class="token-claims-header">
                  <h3>{text.accessToken}</h3>
                  <span>{text.decodedPayload}</span>
                </div>
                <dl>
                  {accessTokenClaims.map(([name, value]) => (
                    <div>
                      <dt>{name}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                  <div class="token-claim-tenant">
                    <dt>tenant_id</dt>
                    <dd>
                      <span>{tenantClaim.value}</span>
                      <span class="token-claim-note">{tenantClaim.organization}</span>
                    </dd>
                  </div>
                </dl>
              </div>
            </div>
            <p class="site-evidence">{text.oidcEvidence}</p>
          </div>
        </div>
      </section>

      <section class="site-section" aria-labelledby="home-sso" data-home-section="sso">
        <div class="site-section-inner home-section-body">
          <SectionHeader
            id="home-sso"
            question={text.ssoQuestion}
            answer={text.ssoAnswer}
            lead={text.ssoLead}
            link={{ href: docs("enterprise-sso"), label: text.ssoLink }}
          />
          <div class="home-figure">
            <div class="home-stack">
              <ProductFrame
                frame="enterpriseSso"
                viewport={842}
                locale={locale}
                host="northwind.xid.dev/console/enterprise-sso"
                height={314}
                class="home-stack-back"
              />
              <ProductFrame
                frame="directorySync"
                viewport={694}
                narrowViewport={356}
                locale={locale}
                host="northwind.xid.dev/console/directory-sync"
                height={249}
                narrowHeight={538}
                class="home-stack-front"
              />
            </div>
            <p class="site-evidence">{text.ssoEvidence}</p>
          </div>
        </div>
      </section>

      <section class="site-section" aria-labelledby="home-console" data-home-section="console">
        <div class="site-section-inner home-console">
          <SectionHeader
            id="home-console"
            question={text.consoleQuestion}
            answer={text.consoleAnswer}
            lead={text.consoleLead}
            link={{ href: docs("organizations"), label: text.consoleLink }}
            layout="stack"
            class="home-console-header"
          />
          <ProductFrame
            frame="scopeSwitcher"
            viewport={1320}
            narrowViewport={356}
            locale={locale}
            host="northwind.xid.dev/console"
            height={440}
            narrowHeight={392}
            class="home-console-frame"
          />
          <p class="site-evidence home-console-evidence">{text.consoleEvidence}</p>
        </div>
      </section>

      <section class="home-cloud" aria-labelledby="home-cloud" data-home-section="cloud">
        <div class="site-section-inner home-section-body">
          <SectionHeader id="home-cloud" question={text.cloudQuestion} answer={text.cloudAnswer} lead={text.cloudLead} />
          <dl class="fact-strip">
            {surface.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
          <div class="home-actions home-cloud-actions">
            <LinkButton href={startFreeHref} size="lg">{text.startFreeOnCloud}</LinkButton>
            <LinkButton href={selfHostingHref} variant="secondary" size="lg">{text.selfHostingGuide}</LinkButton>
            <a class="text-link home-cloud-pricing" href={pricingHref}>{text.seePricing}</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .home-hero {
    overflow-x: clip;
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--xid-border);
  }

  .home-hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s8);
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s5);
    min-width: 0;
  }

  .home-hero-title {
    display: flex;
    flex-direction: column;
    max-width: 42.5rem;
    margin: 0;
    font-size: var(--xid-text-hero);
    font-weight: var(--xid-weight-display);
    line-height: var(--xid-leading-hero);
    letter-spacing: var(--xid-tracking-display);
    text-wrap: balance;
  }

  .home-hero-question {
    color: var(--xid-muted-foreground);
  }

  .home-hero-lead {
    max-width: 25rem;
    margin: 0;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-lg);
    line-height: 1.5;
  }

  .home-hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s4);
    padding-top: var(--xid-space-s1);
  }

  .home-actions {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s3);
  }

  .home-hero-note {
    margin: 0;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-sm);
    line-height: var(--xid-leading-sm);
  }

  .home-hero-visual :global(.home-hero-console) {
    display: none;
  }

  .home-section-body {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.4vw, 3rem);
  }

  .home-figure {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s3);
    min-width: 0;
  }

  .home-oidc {
    background: var(--xid-sidebar);
  }

  :global(:root[data-theme='dark']) .home-oidc {
    background: var(--xid-bg);
  }

  .code-with-result {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s4);
  }

  .home-code {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--xid-radius);
    background: var(--xid-code);
    color: var(--xid-code-foreground);
  }

  .home-code figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid color-mix(in srgb, var(--xid-code-foreground) 10%, transparent);
    font-family: var(--xid-font-mono);
    font-size: var(--xid-text-xs);
    line-height: var(--xid-leading-xs);
  }

  .home-code figcaption span:first-child {
    color: color-mix(in srgb, var(--xid-code-foreground) 70%, transparent);
  }

  .home-code figcaption span:last-child {
    color: color-mix(in srgb, var(--xid-code-foreground) 50%, transparent);
  }

  .home-code pre {
    margin: 0;
    padding: var(--xid-space-s4) 0.875rem var(--xid-space-s5);
    overflow-x: auto;
    font-family: var(--xid-font-mono);
    font-size: var(--xid-text-sm);
    line-height: 1.375rem;
    tab-size: 2;
  }

  .token-claims {
    display: flex;
    flex-direction: column;
    padding: var(--xid-space-s1) 0.875rem var(--xid-space-s2);
    border: 1px solid var(--xid-border);
    border-radius: var(--xid-radius);
    background: var(--xid-surface);
  }

  .token-claims-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.5rem;
  }

  .token-claims-header h3 {
    margin: 0;
    font-size: var(--xid-text-base);
    font-weight: var(--xid-weight-display);
    line-height: var(--xid-leading-sm);
  }

  .token-claims-header span {
    color: var(--xid-faint-foreground);
    font-size: var(--xid-text-xs);
    line-height: var(--xid-leading-xs);
  }

  .token-claims dl {
    margin: 0;
  }

  .token-claims dl > div {
    display: flex;
    align-items: center;
    min-height: 2rem;
    border-top: 1px solid var(--xid-border);
  }

  .token-claims dt {
    flex: 0 0 6rem;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-xs);
    line-height: var(--xid-leading-xs);
  }

  .token-claims dd {
    min-width: 0;
    margin: 0;
    font-family: var(--xid-font-mono);
    font-size: var(--xid-text-sm);
    line-height: var(--xid-leading-xs);
    overflow-wrap: anywhere;
  }

  .token-claims .token-claim-tenant {
    padding: var(--xid-space-s2);
    border-radius: var(--xid-radius-sm);
    background: var(--xid-muted);
  }

  .token-claim-tenant dt {
    flex-basis: 5.5rem;
  }

  .token-claim-tenant dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem var(--xid-space-s2);
  }

  .token-claim-note {
    color: var(--xid-muted-foreground);
    font-family: var(--xid-font);
    font-size: var(--xid-text-xs);
  }

  .home-stack :global(.home-stack-back) {
    display: none;
  }

  .home-console {
    display: flex;
    flex-direction: column;
    gap: var(--xid-space-s5);
  }

  .home-console :global(.home-console-frame) {
    margin-top: var(--xid-space-s2);
  }

  .home-cloud {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .fact-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--xid-border);
  }

  .fact-strip > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--xid-space-s1);
    min-width: 0;
    padding: var(--xid-space-s4) var(--xid-space-s4) var(--xid-space-s4) 0;
    border-bottom: 1px solid var(--xid-border);
  }

  .fact-strip > div:nth-child(even) {
    padding-left: var(--xid-space-s4);
    border-left: 1px solid var(--xid-border);
  }

  .fact-strip dt {
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-xs);
    line-height: var(--xid-leading-xs);
  }

  .fact-strip dd {
    margin: 0;
    font-size: var(--xid-text-xl);
    font-weight: var(--xid-weight-medium);
    line-height: var(--xid-leading-xl);
    letter-spacing: var(--xid-tracking-heading);
    font-variant-numeric: tabular-nums;
  }

  .home-cloud-pricing {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
  }

  @media (min-width: 48rem) {
    .home-actions {
      flex-direction: row;
      align-items: center;
    }

    .home-cloud-pricing {
      min-height: 0;
      margin-left: var(--xid-space-s3);
    }

    .fact-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .fact-strip > div {
      gap: 0.375rem;
      padding: var(--xid-space-s6);
      border-bottom: 0;
      border-left: 1px solid var(--xid-border);
    }

    .fact-strip > div:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .fact-strip {
      border-bottom: 1px solid var(--xid-border);
    }

    .fact-strip dd {
      font-size: var(--xid-text-xxl);
      line-height: var(--xid-leading-xxl);
    }
  }

  @media (min-width: 64rem) {
    .home-hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 27rem;
      align-items: center;
      gap: var(--xid-space-s10);
    }

    .home-hero-copy {
      gap: var(--xid-space-s6);
    }

    .home-hero-visual {
      position: relative;
      height: 34.25rem;
    }

    .home-hero-visual :global(.home-hero-console) {
      display: flex;
      position: absolute;
      top: 0;
      left: 6rem;
      width: 39rem;
      border-right: 0;
      border-radius: var(--xid-radius-lg) 0 0 var(--xid-radius-lg);
    }

    .home-hero-visual :global(.home-hero-signin) {
      position: absolute;
      top: 6.5rem;
      left: -1rem;
      width: 22rem;
    }

    .code-with-result {
      flex-direction: row;
      align-items: flex-start;
    }

    .home-code {
      flex: 1 1 0;
    }

    .token-claims {
      flex: 0 0 27.5rem;
      padding-inline: var(--xid-space-s4);
    }

    .home-stack {
      position: relative;
      height: 37.9375rem;
    }

    .home-stack :global(.home-stack-back) {
      display: flex;
      position: absolute;
      top: 0;
      left: 0;
      width: min(52.75rem, 100%);
    }

    .home-stack :global(.home-stack-front) {
      position: absolute;
      top: 20.25rem;
      right: 0;
      width: min(43.5rem, 100%);
    }

    .home-console {
      display: grid;
      grid-template-columns: 27.5rem minmax(0, 1fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '. frame'
        'header frame'
        'evidence frame'
        '. frame';
      column-gap: var(--xid-space-s16);
      row-gap: var(--xid-space-s6);
    }

    .home-console :global(.home-console-header) {
      grid-area: header;
    }

    .home-console :global(.home-console-frame) {
      grid-area: frame;
      align-self: center;
      margin-top: 0;
    }

    .home-console-evidence {
      grid-area: evidence;
    }
  }
</style>

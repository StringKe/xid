---
import { getDocsPageProps, getLastUpdated, getRouteFlags, getTOC } from "@cloudflare/nimbus-docs";
import { components } from "../components";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getDocsBreadcrumbs, getDocsNavigation, getDocsPrevNext } from "../lib/docs-navigation";
import { getDocsEvidence } from "../lib/docs-evidence";
import { parsePublicDocsRoute } from "../lib/docs-registry";
import { SITE_DOCS_SOURCE_URL } from "../lib/site-links";
import DocsHub from "./DocsHub.astro";

const { entry, Content, headings } = await getDocsPageProps(Astro);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const route = parsePublicDocsRoute(currentSlug);
const isHub = route?.kind === "hub";
const evidence = route?.slug ? getDocsEvidence(route.slug, Astro.url.pathname) : undefined;
const navigation = getDocsNavigation(currentSlug);
const { tableOfContents: tocOn } = await getRouteFlags(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : [];
// 生成态 locale 产物无独立 Git 历史，lastUpdated 只信显式元数据。
const hasGeneratedSource = /[/\\]content[/\\]generated[/\\]/.test(entry.filePath ?? "");
const lastUpdated =
  entry.data.lastUpdated ?? (hasGeneratedSource ? undefined : await getLastUpdated(entry));
const markdownPath = currentSlug === "/" ? "/index.md" : `${currentSlug}/index.md`;
const markdownUrl = entry.data.noindex
  ? undefined
  : Astro.site
    ? new URL(markdownPath, Astro.site).href
    : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  navigation={navigation}
  isHub={isHub}
  evidence={evidence}
  headings={toc}
  breadcrumbs={getDocsBreadcrumbs(navigation, currentSlug)}
  prevNext={getDocsPrevNext(navigation, currentSlug)}
  editUrl={SITE_DOCS_SOURCE_URL}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  draft={entry.data.draft}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  collection={entry.collection}
  entryId={entry.id}
>
  {isHub ? <DocsHub navigation={navigation} /> : <Content components={components} />}
</DocsLayout>

---
import {
  getBreadcrumbs,
  getDocsPageProps,
  getEditUrl,
  getLastUpdated,
  getPrevNext,
  getRouteFlags,
  getSidebar,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../components";
import DocsLayout from "../layouts/DocsLayout.astro";
import { scopeSidebarToSiteLocale } from "../lib/sidebar-locale";
import { getSiteLocale, localizeSitePath } from "../lib/site-locale";

const { entry, Content, headings } = await getDocsPageProps(Astro);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const { sidebar: sidebarOn, tableOfContents: tocOn } =
  await getRouteFlags(entry);
const sidebar = sidebarOn
  ? await getSidebar(currentSlug, {
      collection: entry.collection,
      transform: ({ tree }) =>
        scopeSidebarToSiteLocale(tree, currentSlug),
    })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const locale = getSiteLocale(Astro.url.pathname);
const rawBreadcrumbs = await getBreadcrumbs(currentSlug, {
  collection: entry.collection,
});
const breadcrumbs = rawBreadcrumbs.map((item) => ({
  ...item,
  href:
    item.href?.startsWith("/")
      ? localizeSitePath(item.href, locale)
      : item.href,
}));
const editUrl = await getEditUrl(entry);
// 生成态 locale 产物无独立 Git 历史，lastUpdated 只信显式元数据。
const hasGeneratedSource = /[/\\]content[/\\]generated[/\\]/.test(entry.filePath ?? "");
const lastUpdated =
  entry.data.lastUpdated ??
  (hasGeneratedSource ? undefined : await getLastUpdated(entry));
const tocConfig = entry.data.tableOfContents;
const toc =
  tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath =
  currentSlug === "/" ? "/index.md" : `${currentSlug}/index.md`;
const markdownUrl = entry.data.noindex
  ? undefined
  : Astro.site
    ? new URL(markdownPath, Astro.site).href
    : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>

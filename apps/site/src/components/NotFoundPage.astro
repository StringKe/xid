---
// 结构同产品 EmptyState first-use：一行标题、一行说明、一个主按钮，上下 1px 线。
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { LinkButton } from "./ui/link-button";
import { getSiteLocale, localizeSitePath } from "@/lib/site-locale";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

type Props = {
  pathname: string;
};

const { pathname } = Astro.props;
const pageNotFound = translateSiteMessage(pathname, siteShellMessages.pageNotFound);
const pageNotFoundDescription = translateSiteMessage(
  pathname,
  siteShellMessages.pageNotFoundDescription,
);
const backHome = translateSiteMessage(pathname, siteShellMessages.backHome);
const homeHref = localizeSitePath("/", getSiteLocale(pathname));
---

<BaseLayout
  title={pageNotFound}
  description={pageNotFoundDescription}
  noindex
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main
      id="main-content"
      data-pagefind-ignore
      class="mx-auto w-full max-w-[calc(var(--site-cap)+2*var(--site-gutter))] flex-1 px-(--site-gutter) py-16 lg:py-24"
    >
      <div class="flex max-w-(--xid-size-prose-width) flex-col items-start gap-2 border-y border-border py-8">
        <p class="m-0 text-xs font-medium text-muted-foreground tabular-nums">404</p>
        <h1 class="m-0 text-lg font-display tracking-title text-foreground">{pageNotFound}</h1>
        <p class="m-0 text-base text-muted-foreground">{pageNotFoundDescription}</p>
        <LinkButton href={homeHref} class="mt-4">{backHome}</LinkButton>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

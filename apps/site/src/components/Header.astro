---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import SiteAuthActions from "./SiteAuthActions.astro";
import SiteLanguageSwitcher from "./SiteLanguageSwitcher.astro";
import { config } from "virtual:nimbus/config";
import { parsePublicDocsRoute } from "@/lib/docs-registry";
import {
  getSiteLocale,
  localizeSitePath,
  stripSiteLocale,
} from "@/lib/site-locale";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /** Whether the surrounding layout provides a mobile navigation dialog. */
  showMobileMenu?: boolean;
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { showMobileMenu = true } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const locale = getSiteLocale(Astro.url.pathname);
const homeHref = localizeSitePath("/", locale);
const docsHref = localizeSitePath("/docs", locale);
const gettingStartedHref = localizeSitePath("/getting-started", locale);
const statusHref = localizeSitePath("/status", locale);
const unlocalizedPath = stripSiteLocale(currentSlug);
const sectionsLabel = translateSiteMessage(Astro.url.pathname, siteShellMessages.sections);
const openNavigationLabel = translateSiteMessage(
  Astro.url.pathname,
  siteShellMessages.openNavigation,
);
const primaryNavigation = [
  {
    href: homeHref,
    label: translateSiteMessage(Astro.url.pathname, siteShellMessages.product),
    active: unlocalizedPath === "/",
  },
  {
    href: docsHref,
    label: translateSiteMessage(Astro.url.pathname, siteShellMessages.documentation),
    active:
      unlocalizedPath !== "/getting-started" &&
      parsePublicDocsRoute(currentSlug) !== null,
  },
  {
    href: gettingStartedHref,
    label: translateSiteMessage(Astro.url.pathname, siteShellMessages.gettingStarted),
    active: unlocalizedPath === "/getting-started",
  },
  {
    href: statusHref,
    label: translateSiteMessage(Astro.url.pathname, siteShellMessages.status),
    active: unlocalizedPath === "/status",
  },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      <a href={homeHref} class="group">
        <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
          {config.title}
        </span>
      </a>

      <nav aria-label={sectionsLabel} class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {primaryNavigation.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors",
                item.active
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {item.label}
            </a>
          ))}
      </nav>
    </div>

    <div class="flex items-center gap-2">
      {!showMobileMenu && (
        <a href={docsHref} class="md:hidden text-xs font-medium text-muted-foreground no-underline hover:text-foreground">
          {translateSiteMessage(Astro.url.pathname, siteShellMessages.documentation)}
        </a>
      )}
      <SiteAuthActions class="hidden lg:flex" />
      <SiteLanguageSwitcher />
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showMobileMenu && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={openNavigationLabel}
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>

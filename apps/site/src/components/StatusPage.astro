---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";
import { getSiteLocale } from "@/lib/site-locale";
import { getStatusSurface, STATUS_API_PATH } from "@/lib/status-surface";

const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
const surface = getStatusSurface(getSiteLocale(Astro.url.pathname));
const title = surface.title;
const description = surface.description;
const markdownUrl = Astro.site
  ? new URL(surface.markdownPath, Astro.site).href
  : surface.markdownPath;
const copy = {
  currentPublicStatus: translate(siteShellMessages.currentPublicStatus),
  loading: translate(siteShellMessages.loading),
  operational: translate(siteShellMessages.operational),
  degraded: translate(siteShellMessages.degraded),
  partialOutage: translate(siteShellMessages.partialOutage),
  majorOutage: translate(siteShellMessages.majorOutage),
  investigating: translate(siteShellMessages.investigating),
  identified: translate(siteShellMessages.identified),
  monitoring: translate(siteShellMessages.monitoring),
  resolved: translate(siteShellMessages.resolved),
  noIncidentsReported: translate(siteShellMessages.noIncidentsReported),
  incidentHistory: translate(siteShellMessages.incidentHistory),
  unavailable: translate(siteShellMessages.liveStatusUnavailable),
  lastUpdated: translate(siteShellMessages.lastUpdated),
};
---

<BaseLayout
  title={title}
  description={description}
  markdownUrl={markdownUrl}
  socialImage="/og.png"
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main-content" data-pagefind-body class="status-page">
      <header class="status-heading">
        <p class="status-kicker">{copy.currentPublicStatus}</p>
        <h1>{title}</h1>
        <p class="status-lead">{description}</p>
      </header>
      <section
        id="live-status"
        class="status-live"
        aria-live="polite"
        data-copy={JSON.stringify(copy)}
        data-endpoint={STATUS_API_PATH}
      >
        <div class="status-summary" data-status-summary>
          <span class="status-indicator" data-status-indicator></span>
          <strong data-status-label>{copy.loading}</strong>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>

  <script>
    type IncidentUpdate = {
      id: string;
      status: "investigating" | "identified" | "monitoring" | "resolved";
      message: string;
      createdAt: string;
    };
    type Incident = {
      id: string;
      title: string;
      status: IncidentUpdate["status"];
      impact: "none" | "minor" | "major" | "critical";
      summary: string;
      startedAt: string;
      resolvedAt: string | null;
      updates: IncidentUpdate[];
    };
    type StatusResponse = {
      status: "operational" | "degraded" | "partial_outage" | "major_outage";
      updatedAt: string | null;
      incidents: Incident[];
    };

    const root = document.querySelector<HTMLElement>("#live-status");
    if (root) {
      const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;
      const endpoint = root.dataset.endpoint;
      const statusLabel = root.querySelector<HTMLElement>("[data-status-label]");
      const statusIndicator = root.querySelector<HTMLElement>("[data-status-indicator]");
      const labels: Record<StatusResponse["status"] | IncidentUpdate["status"], string> = {
        operational: copy.operational,
        degraded: copy.degraded,
        partial_outage: copy.partialOutage,
        major_outage: copy.majorOutage,
        investigating: copy.investigating,
        identified: copy.identified,
        monitoring: copy.monitoring,
        resolved: copy.resolved,
      };
      const date = (value: string) =>
        new Intl.DateTimeFormat(document.documentElement.lang, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(value));
      const text = (tag: string, value: string, className?: string) => {
        const element = document.createElement(tag);
        element.textContent = value;
        if (className) element.className = className;
        return element;
      };

      if (!endpoint) throw new Error("status_endpoint_missing");
      fetch(endpoint, {
        headers: { Accept: "application/json" },
        signal: AbortSignal.timeout(10_000),
      })
        .then(async (response) => {
          if (!response.ok) throw new Error("status_request_failed");
          return (await response.json()) as StatusResponse;
        })
        .then((data) => {
          if (!labels[data.status] || !Array.isArray(data.incidents)) {
            throw new Error("status_response_invalid");
          }
          if (statusLabel) statusLabel.textContent = labels[data.status];
          if (statusIndicator) statusIndicator.dataset.state = data.status;
          if (data.updatedAt) {
            const updated = text(
              "p",
              `${copy.lastUpdated}: ${date(data.updatedAt)}`,
              "status-updated",
            );
            root.append(updated);
          }
          const heading = text("h2", copy.incidentHistory, "status-section-title");
          root.append(heading);
          if (data.incidents.length === 0) {
            root.append(text("p", copy.noIncidentsReported, "status-empty"));
            return;
          }
          const list = document.createElement("div");
          list.className = "status-incidents";
          for (const incident of data.incidents) {
            const article = document.createElement("article");
            article.className = "status-incident";
            const headline = document.createElement("div");
            headline.className = "status-incident-heading";
            headline.append(
              text("h3", incident.title),
              text("span", labels[incident.status], "status-incident-state"),
            );
            article.append(
              headline,
              text("p", incident.summary, "status-incident-summary"),
              text("time", date(incident.startedAt), "status-incident-time"),
            );
            if (incident.updates.length > 0) {
              const updates = document.createElement("ol");
              updates.className = "status-updates";
              for (const update of incident.updates) {
                const item = document.createElement("li");
                item.append(
                  text("time", date(update.createdAt)),
                  text("strong", labels[update.status]),
                  text("p", update.message),
                );
                updates.append(item);
              }
              article.append(updates);
            }
            list.append(article);
          }
          root.append(list);
        })
        .catch(() => {
          if (statusLabel) statusLabel.textContent = copy.unavailable;
          if (statusIndicator) statusIndicator.dataset.state = "unavailable";
        });
    }
  </script>
</BaseLayout>

<style is:global>
  .status-page {
    flex: 1;
    width: 100%;
    max-width: calc(var(--site-cap) + 2 * var(--site-gutter));
    margin-inline: auto;
    padding: var(--xid-space-s16) var(--site-gutter) clamp(4rem, 8vw, 8rem);
  }
  .status-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40rem);
    column-gap: var(--xid-space-s12);
    align-items: end;
    padding-bottom: var(--xid-space-s8);
    border-bottom: 1px solid var(--xid-border);
  }
  .status-kicker {
    grid-column: 1 / -1;
    margin: 0 0 var(--xid-space-s3);
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-xs);
    font-weight: var(--xid-weight-medium);
    line-height: var(--xid-leading-xs);
  }
  .status-heading h1 {
    margin: 0;
    font-size: var(--site-display-title);
    font-weight: var(--xid-weight-display);
    line-height: 1.1;
    letter-spacing: var(--xid-tracking-heading);
    text-wrap: balance;
  }
  .status-lead {
    margin: 0;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-md);
    line-height: 1.6;
  }
  .status-live {
    padding-top: var(--xid-space-s8);
  }
  .status-summary {
    display: flex;
    align-items: center;
    gap: var(--xid-space-s3);
    font-size: var(--xid-text-lg);
    line-height: var(--xid-leading-lg);
  }
  .status-summary strong {
    font-weight: var(--xid-weight-display);
  }
  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--xid-radius-full);
    background: var(--xid-faint-foreground);
  }
  .status-indicator[data-state='operational'] {
    background: var(--xid-success);
  }
  .status-indicator[data-state='degraded'],
  .status-indicator[data-state='partial_outage'] {
    background: var(--xid-warning);
  }
  .status-indicator[data-state='major_outage'],
  .status-indicator[data-state='unavailable'] {
    background: var(--xid-danger);
  }
  .status-updated {
    margin: var(--xid-space-s2) 0 0;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-sm);
    font-variant-numeric: tabular-nums;
  }
  .status-section-title {
    margin: var(--xid-space-s12) 0 0;
    padding-bottom: var(--xid-space-s3);
    border-bottom: 1px solid var(--xid-border);
    font-size: var(--xid-text-lg);
    font-weight: var(--xid-weight-display);
    line-height: var(--xid-leading-lg);
    letter-spacing: var(--xid-tracking-title);
  }
  .status-empty {
    margin: 0;
    padding-block: var(--xid-space-s6);
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-base);
  }
  .status-incident {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(16rem, 5fr);
    column-gap: var(--xid-space-s12);
    padding-block: var(--xid-space-s6);
    border-bottom: 1px solid var(--xid-border);
  }
  .status-incident-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--xid-space-s4);
  }
  .status-incident-heading h3 {
    margin: 0;
    font-size: var(--xid-text-md);
    font-weight: var(--xid-weight-display);
    line-height: var(--xid-leading-md);
  }
  .status-incident-state {
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-xs);
    font-weight: var(--xid-weight-medium);
    white-space: nowrap;
  }
  .status-incident-summary {
    margin: var(--xid-space-s2) 0;
    color: var(--xid-muted-foreground);
    font-size: var(--xid-text-base);
    line-height: 1.55;
  }
  .status-incident-time,
  .status-updates time {
    color: var(--xid-faint-foreground);
    font-size: var(--xid-text-xs);
    font-variant-numeric: tabular-nums;
  }
  .status-updates {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .status-updates li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    column-gap: var(--xid-space-s3);
    padding-block: var(--xid-space-s3);
    border-bottom: 1px solid var(--xid-border);
    font-size: var(--xid-text-sm);
  }
  .status-updates strong {
    font-weight: var(--xid-weight-medium);
  }
  .status-updates p {
    grid-column: 2;
    margin: var(--xid-space-s1) 0 0;
    color: var(--xid-muted-foreground);
    line-height: 1.5;
  }
  @media (max-width: 63.99rem) {
    .status-heading,
    .status-incident {
      grid-template-columns: 1fr;
      row-gap: var(--xid-space-s4);
    }
    .status-updates {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>

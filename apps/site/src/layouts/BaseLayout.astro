---
import "../styles/globals.css";
import "../styles/mermaid.css";
import "../styles/prose.css";
import { config } from "virtual:nimbus/config";
import { THEME_COLOR } from "@xid-kit/web-ui/theme-preference";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";
import {
  getSiteLlmsIndexPath,
  getSiteLocale,
  getSiteLocaleAlternates,
  getSiteOpenGraphLocale,
} from "@/lib/site-locale";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

type Props = BasePageProps & {
  documentTitle?: string;
};

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  documentTitle,
} = Astro.props;

const lang = getSiteLocale(Astro.url.pathname);
const localeAlternates = getSiteLocaleAlternates(Astro.url.pathname);
const translate = (descriptor: Parameters<typeof translateSiteMessage>[1]) =>
  translateSiteMessage(Astro.url.pathname, descriptor);
// 空 alternate 抑制 NimbusHead 对显式 noindex 页的默认回填。
const llmsIndexPath = noindex ? "" : getSiteLlmsIndexPath(lang);
const llmsUrl = Astro.site
  ? new URL(llmsIndexPath, Astro.site).href
  : llmsIndexPath;
const openGraphLocale = getSiteOpenGraphLocale(lang);
const socialImageTitle = title !== config.title ? `${title} | ${config.title}` : title;
const socialImageAlt = description
  ? `${socialImageTitle}. ${description}`
  : socialImageTitle;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const markdownHref = markdownUrl
  ? Astro.site
    ? new URL(markdownUrl, Astro.site).href
    : markdownUrl
  : null;
const shikiCssHref = `${import.meta.env.BASE_URL}_nimbus/shiki.css${import.meta.env.DEV ? `?v=${Date.now()}` : ""}`;
const customHead = [...(config.head ?? []), ...pageHead];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR.light} />

    {/* 与 apps/server、apps/console 首帧脚本同一逻辑：读 xid.theme，未选择时跟随系统。 */}
    <script is:inline define:vars={{ themeColor: THEME_COLOR }}>
      (() => {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const readMode = () => {
          try {
            const value = localStorage.getItem("xid.theme");
            return value === "light" || value === "dark" ? value : "system";
          } catch {
            return "system";
          }
        };
        const apply = () => {
          const mode = readMode();
          const scheme = mode === "system" ? (media.matches ? "dark" : "light") : mode;
          const root = document.documentElement;
          root.dataset.theme = scheme;
          root.style.colorScheme = scheme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor[scheme]);
          document.querySelectorAll("[data-theme-control]").forEach((control) => {
            control.setAttribute("data-scheme", scheme);
            if (control instanceof HTMLSelectElement) control.value = mode;
          });
        };
        apply();
        media.addEventListener("change", apply);
        window.addEventListener("storage", (event) => {
          if (event.key === "xid.theme") apply();
        });
        window.__xidApplyTheme = apply;
      })();
    </script>

    {documentTitle ? (
      <>
        <title>{documentTitle}</title>
        <meta name="generator" content={Astro.generator} />
        {description && <meta name="description" content={description} />}
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="stylesheet" href={shikiCssHref} />
        {canonical && <link rel="canonical" href={canonical} />}
        {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
        {llmsUrl && (
          <link rel="alternate" type="text/plain" href={llmsUrl} title="LLM index" />
        )}
        {markdownHref && (
          <link
            rel="alternate"
            type="text/markdown"
            href={markdownHref}
            title="Markdown"
          />
        )}
        {customHead.map(({ tag: Tag, attrs = {}, content }) =>
          content
            ? <Tag {...attrs} set:html={content} />
            : <Tag {...attrs} />
        )}
      </>
    ) : (
      <NimbusHead
        title={title}
        description={description}
        noindex={noindex}
        markdownUrl={markdownHref ?? undefined}
        socialImage={socialImage}
        lastUpdated={lastUpdated}
        head={pageHead}
        collection={collection}
        entryId={entryId}
        locale={lang}
        openGraphLocale={openGraphLocale}
        socialImageAlt={socialImageAlt}
        llmsIndexUrl={llmsUrl}
      />
    )}
    {localeAlternates.map(({ locale, href }) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={Astro.site ? new URL(href, Astro.site).href : href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={Astro.site ? new URL(localeAlternates[0].href, Astro.site).href : localeAlternates[0].href}
    />
  </head>
  <body
    class="min-h-screen bg-background text-foreground"
    data-mermaid-close-label={translate(siteShellMessages.closeDiagram)}
    data-mermaid-error-label={translate(siteShellMessages.diagramFailed)}
    data-mermaid-expand-label={translate(siteShellMessages.expandDiagram)}
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3.5 focus:py-2 focus:text-base focus:font-medium focus:text-primary-foreground"
    >
      {translate(siteShellMessages.skipToContent)}
    </a>
    {markdownUrl && <AgentDirective markdownUrl={markdownUrl} llmsUrl={llmsUrl} />}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
    <script>
      import "../scripts/mermaid";
    </script>
  </body>
</html>

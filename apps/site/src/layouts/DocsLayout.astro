---
// 文档布局：248px 侧栏（同 Console）、正文列 43.5rem（≥90rem 52rem）、≥90rem 显示右侧目录。
import "@/styles/site-sections.css";
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { Badge } from "@/components/ui/badge";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Pagination } from "@/components/ui/pagination";
import DocsSidebarNav from "@/components/ui/sidebar/DocsSidebarNav.astro";
import { MobileTOC, TOC } from "@/components/ui/toc";
import type { Breadcrumb, HeadElement, PrevNext, TOCItem } from "@cloudflare/nimbus-docs/types";
import { cn } from "@/lib/cn";
import type { DocsEvidence } from "@/lib/docs-evidence";
import type { DocsNavigation } from "@/lib/docs-navigation";
import Aside from "@/components/ui/aside/Aside.astro";
import { translateSiteMessage } from "@/lib/site-i18n";
import { siteShellMessages } from "@/lib/site-shell-messages";

type Props = {
  title: string;
  description?: string;
  navigation: DocsNavigation;
  /** 文档首页自带标题区，不渲染文章标题、面包屑、目录和翻页。 */
  isHub?: boolean;
  evidence?: DocsEvidence;
  headings?: TOCItem[];
  breadcrumbs?: Breadcrumb[];
  prevNext?: PrevNext;
  editUrl?: string;
  head?: HeadElement[];
  noindex?: boolean;
  draft?: boolean;
  searchable?: boolean;
  markdownUrl?: string;
  socialImage?: string;
  lastUpdated?: Date;
  collection?: string;
  entryId?: string;
};

const {
  title,
  description,
  navigation,
  isHub = false,
  evidence,
  headings = [],
  breadcrumbs = [],
  prevNext = {},
  editUrl,
  head = [],
  noindex,
  draft,
  searchable,
  markdownUrl,
  socialImage,
  lastUpdated,
  collection,
  entryId,
} = Astro.props;

// searchable 缺省跟 noindex：不可爬则默认也不进站内搜。
const pagefindAttrs = (searchable ?? !(noindex || draft))
  ? { "data-pagefind-body": "" }
  : { "data-pagefind-ignore": "" };
const draftLabel = translateSiteMessage(Astro.url.pathname, siteShellMessages.draft);
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex || draft}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  head={head}
  collection={collection}
  entryId={entryId}
>
  <SiteHeader variant="docs" docsNavigation={navigation} />
  <div class="flex">
    <aside
      data-docs-sidebar
      class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-(--nb-sidebar-width) shrink-0 overflow-y-auto overscroll-contain border-r border-border bg-sidebar px-3 py-5 lg:block"
    >
      <DocsSidebarNav navigation={navigation} />
    </aside>
    <script is:inline>
      (() => {
        const sidebar = document.querySelector("[data-docs-sidebar]");
        const current = sidebar?.querySelector("[aria-current='page']");
        if (!sidebar || !current) return;
        const top = current.offsetTop - sidebar.clientHeight / 2;
        if (top > 0) sidebar.scrollTop = top;
      })();
    </script>

    <main id="main-content" class="min-w-0 flex-1">
      <div
        class={cn(
          "px-4 pb-16 lg:pb-24 lg:pl-16 lg:pr-8",
          isHub ? "max-w-[calc(var(--xid-size-docs-width-wide)+6rem)] pt-8 lg:pt-14" : "max-w-[calc(var(--nb-content-max)+6rem)] lg:pt-12",
        )}
      >
        <div {...pagefindAttrs}>
          {isHub ? (
            <slot />
          ) : (
            <Fragment>
              <Breadcrumbs
                items={breadcrumbs}
                class="-mx-4 border-b border-border bg-sidebar px-4 py-3 lg:mx-0 lg:border-0 lg:bg-transparent lg:p-0"
              />
              <div class="mt-6 flex flex-col gap-2 lg:mt-5">
                <div class="flex flex-wrap items-center gap-3">
                  <h1 class="m-0 text-xl font-display tracking-heading text-foreground [text-wrap:balance]">{title}</h1>
                  {draft && <Badge text={draftLabel} variant="warning" />}
                </div>
                {description && (
                  <p class="m-0 text-md text-muted-foreground [text-wrap:pretty]">{description}</p>
                )}
              </div>
              {evidence && (
                <Aside type="note" class="mb-0 mt-5" data-docs-evidence>
                  <p>{evidence.sentence}</p>
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    <Badge text={evidence.status} variant={evidence.badge} class="bg-card" />
                    <a class="text-link" href={evidence.rowHref}>{evidence.rowLabel}</a>
                  </p>
                </Aside>
              )}
              {headings.length > 0 && <MobileTOC headings={headings} class="mt-5 xl:hidden" />}
              <article class="docs-content mt-6">
                <slot />
              </article>
            </Fragment>
          )}
        </div>
        {!isHub && <Pagination prevNext={prevNext} />}
      </div>
    </main>

    {!isHub && (
      <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-(--nb-toc-width) shrink-0 overflow-y-auto px-6 py-14 xl:block">
        <TOC headings={headings} editUrl={editUrl} />
      </aside>
    )}
  </div>
</BaseLayout>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.xid</groupId>
  <artifactId>xid-sdk-java</artifactId>
  <version>0.1.0-alpha.0</version>
  <packaging>jar</packaging>

  <name>XID Java SDK</name>
  <description>
    XID 身份平台 Java 服务端 SDK -- networkless JWT 验证 / 请求认证 / webhook 验证。
    使用 JDK 内置 java.security,无第三方密码学库依赖。
    Status: implemented
  </description>
  <url>https://github.com/StringKe/xid</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>StringKe</id>
      <name>StringKe</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/StringKe/xid.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/StringKe/xid.git</developerConnection>
    <url>https://github.com/StringKe/xid</url>
  </scm>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    零运行时依赖:所有加密原语均来自 JDK java.security / javax.crypto。
    测试依赖使用 main() 方法断言,无需 JUnit/Mockito。
  -->
  <dependencies/>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
    </plugins>
  </build>
</project>

{
  "name": "xid/xid",
  "description": "XID Identity Platform -- PHP server-side SDK (JWT verification, request authentication, webhook validation)",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "xid",
    "identity",
    "oidc",
    "jwt",
    "authentication",
    "webhook"
  ],
  "homepage": "https://xid.dev",
  "authors": [
    {
      "name": "StringKe",
      "homepage": "https://github.com/StringKe"
    }
  ],
  "support": {
    "issues": "https://github.com/StringKe/xid/issues",
    "source": "https://github.com/StringKe/xid"
  },
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^7.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Xid\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Xid\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}

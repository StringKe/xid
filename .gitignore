# stdagent 本地缓存/状态(源标准在 .stdai/standards,不同步这些运行时产物)
.stdai/cache/
.stdai/backups/
.stdai/logs/
.stdai/state.json

# dependencies
node_modules/

# monorepo 构建与缓存(匹配任意深度的同名目录)
dist/
build/
coverage/
.turbo/
.react-router/
*.tsbuildinfo

# 原生 SDK 工具链产物(Rust/Gradle/Dart/Go 等)
sdk/**/target/
sdk/**/.gradle/
sdk/**/bin/
sdk/**/obj/
sdk/**/.build/
sdk/**/.dart_tool/
sdk/**/vendor/
sdk/**/local.properties
sdk/**/.flutter-plugins-dependencies
sdk/**/pubspec.lock

# Cloudflare / 本地实例
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
worker-configuration.d.ts
.xid/

# 本地 AI 会话与个人笔记(不入库;stdagent 同步产物在 .agents/.claude 等)
.grok/
docs/sdlc/
.shot/

# env / logs / os
.env
.env.*
!.env.example
*.log
.DS_Store

# 密钥与证书材料
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# GeoIP 本地调试大文件(设计上存 R2)
*.mmdb

# 解释器缓存
__pycache__/
*.pyc
.phpunit.result.cache
